# =============================================================
# 额外插件清单 —— diy-part3.sh 读本文件写进 .config，再交给 defconfig
#
# 开关：workflow 输入 extra_plugins（本地跑看 EXTRA_PLUGINS 环境变量）
#   true  → 本文件逐条写入 .config
#   false → 本文件里每条都改写成 "# CONFIG_x is not set"
#           （不是「跳过」：跳过的话，机型 config 里残留的 =y 会让
#            「已关闭额外插件」看起来没生效，排查时最容易误判）
#
# 写法（就是 kconfig / diffconfig 语法，从 menuconfig 里拷一行过来即可）：
#   CONFIG_PACKAGE_<包名>=y    装进固件
#   CONFIG_PACKAGE_<包名>=n    有意不装（盖掉机型 config 里的 =y；开关关闭时同样是 not set）
#   # 开头是注释；不支持行尾注释（会把注释一起当值写进 .config）
#
# 加插件 = 往下加一行，diy-part3.sh 和 workflow 都不用动。
#
# ⚠ 只放「机型 config 里没有」的包。本清单里的条目在开关关闭时会被显式写成
#   "# ... is not set"，所以机型 config 里已经固化成 =y 的包**不要放进来**，
#   否则关一次额外插件就把它从固件里删掉了。
#
#   已固化在 configs/<机型>.config、不归本开关管的（16 个机型全部 =y）：
#     CONFIG_PACKAGE_autocore=y          概览页 CPU / 温度 / 负载数据源
#     CONFIG_PACKAGE_luci-theme-argon=y  默认主题
#   这两个关掉会让 LuCI 首页少数据 / 掉回默认主题，属于固件基础功能。
#
# ⚠ 这里只放「包 / 功能符号」。机型符号（CONFIG_TARGET_*）写
#   configs/<机型>.config —— 写在这里会被 defconfig 按机型重新推导后覆盖。
# ⚠ 依赖不用手写：kconfig 按 Makefile 的 DEPENDS 自动带出（luci-app-ddns →
#   ddns-scripts）。只有「默认带不出来、又要指定变体」时才显式写。
# ⚠ 当前源码树 feeds 里没有的包，defconfig 会静默删掉该符号（不留报错）。
#   构建末尾有复核，缺的会打 "额外插件未进入 .config"，只 warning 不阻断。
# =============================================================

## ── Extra packages ──────────────────────────────────────────
# Extra packages ---> autocore      概览页 CPU / 温度 / 负载
#   ⚠ 不在此清单：16 个机型 config 里已是 =y（基础功能），放进来会被「关」连带删掉
#
# Extra packages ---> automount     U 盘自动挂载
CONFIG_PACKAGE_automount=y

## ── LuCI ---> Applications ──────────────────────────────────
# 计划重启
CONFIG_PACKAGE_luci-app-autoreboot=y

# 动态域名 DNS（ddns-scripts 由依赖带出）
CONFIG_PACKAGE_luci-app-ddns=y

# HomeProxy 代理（sing-box 由依赖带出）
CONFIG_PACKAGE_luci-app-homeproxy=y

# ttyd 网页终端
CONFIG_PACKAGE_luci-app-ttyd=y

# UPnP 端口自动转发
CONFIG_PACKAGE_luci-app-upnp=y

# 微信推送
CONFIG_PACKAGE_luci-app-wechatpush=y

# WOL 网络唤醒（etherwake 由依赖带出）
CONFIG_PACKAGE_luci-app-wol=y

## ── LuCI ---> Themes ────────────────────────────────────────
# LuCI ---> Themes ---> luci-theme-argon   argon 主题
#   ⚠ 不在此清单：16 个机型 config 里已是 =y（默认主题），放进来会被「关」连带删掉，
#     固件会掉回 bootstrap。手工 menuconfig 里其实也不用勾。

## ── Network ---> IP Addresses and Names ─────────────────────
# Cloudflare DDNS 脚本（ddns-scripts 的 provider 插件，对应 cloudflare.com-v4.json）
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
